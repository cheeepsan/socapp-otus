    {
      "name": "6. Error cases",
      "description": "Requests that verify the error contract: 400 for invalid input, 401 for missing or unknown tokens, 404 for unknown resources.",
      "item": [
        {
          "name": "Login with wrong password -> 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
