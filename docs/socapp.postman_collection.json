          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{userB_id}}\",\n  \"password\": \"secret-2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Authenticates user B. The test script stores the returned token in {{tokenB}}."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. User profiles",
      "item": [
        {
          "name": "Get user profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"returns the user profile\", function () {",
                  "    pm.expect(body.first_name).to.eql(\"Ivan\");",
                  "    pm.expect(body.second_name).to.eql(\"Petrov\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/get/{{userA_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "get",
                "{{userA_id}}"
              ]
            },
            "description": "Public endpoint. Returns {id, first_name, second_name, birthdate, biography, city}. Unknown id gives 404."
          },
          "response": []
        },
        {
          "name": "Search users by name prefix",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"returns a list of users\", function () {",
                  "    pm.expect(body).to.be.an(\"array\");",
                  "    pm.expect(body.map((u) => u.first_name)).to.include(\"Ivan\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/user/search?first_name=Iva&last_name=Pet",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "search"
              ],
              "query": [
                {
                  "key": "first_name",
                  "value": "Iva"
                },
                {
                  "key": "last_name",
                  "value": "Pet"
                }
              ]
            },
            "description": "Public endpoint. Both query parameters are required and are matched as prefixes (SQL LIKE 'prefix%'). Blank values give 400."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Friends",
      "item": [
        {
          "name": "Add friend (A adds B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/friend/set/{{userB_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "friend",
                "set",
                "{{userB_id}}"
              ]
            },
            "description": "Authenticated (user A). Adds B to A's friend list; adding the same friend twice is a no-op. Empty response body. 400 when the target user does not exist or is the caller; 401 without a valid token.\n\nRequired by \"Feed (posts of friends)\" in the Posts folder."
          },
          "response": []
        },
        {
          "name": "Delete friend (A removes B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/friend/delete/{{userB_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "friend",
                "delete",
                "{{userB_id}}"
              ]
            },
            "description": "Authenticated (user A). Removes B from A's friend list. Always succeeds with an empty body once authenticated (removing a non-friend is a no-op).\n\nRun this at the end of the walkthrough if you like — but note the feed request then returns an empty list."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Posts",
      "item": [
        {
          "name": "Create post (as user B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  // the body is a JSON-encoded string, e.g. \"9f1c...\"",
                  "  const postId = pm.response.json();",
                  "  pm.collectionVariables.set(\"postId\", postId);",
                  "  pm.test(\"returns a post id\", function () {",
                  "    pm.expect(postId).to.be.a(\"string\").and.not.be.empty;",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Hello from Maria\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/post/create",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "create"
              ]
            },
            "description": "Authenticated (user B). The response body is a JSON-encoded string with the new post id (including the quotes), e.g. \"9f1c8a...\". Blank text gives 400.\n\nCreated as user B so that the feed request (user A) shows it."
          },
          "response": []
        },
        {
          "name": "Get post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"returns the post\", function () {",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get(\"postId\"));",
                  "    pm.expect(body).to.have.property(\"author_user_id\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/post/get/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "get",
                "{{postId}}"
              ]
            },
            "description": "Public endpoint. Returns {id, text, author_user_id}. Unknown id gives 404."
          },
          "response": []
        },
        {
          "name": "Update post (as user B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{postId}}\",\n  \"text\": \"Hello from Maria (edited)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/post/update",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "update"
              ]
            },
            "description": "Authenticated (user B, the post author). Only the author can update; a non-author or unknown post id gives 400. Empty response body."
          },
          "response": []
        },
        {
          "name": "Feed (posts of friends)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const posts = pm.response.json();",
                  "  const postId = pm.collectionVariables.get(\"postId\");",
                  "  pm.test(\"feed is a list\", function () {",
                  "    pm.expect(posts).to.be.an(\"array\");",
                  "  });",
                  "  pm.test(\"feed contains user B's post\", function () {",
                  "    pm.expect(posts.map((p) => p.id)).to.include(postId);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/post/feed?offset=0&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "feed"
              ],
              "query": [
                {
                  "key": "offset",
                  "value": "0"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Authenticated (user A). Posts by A's friends, newest first. offset defaults to 0, limit to 10; limit < 1 or offset < 0 gives 400.\n\nRequires \"Add friend (A adds B)\" and \"Create post (as user B)\" to have run first."
          },
          "response": []
        },
        {
          "name": "Delete post (as user B)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenB}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/post/delete/{{postId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post",
                "delete",
                "{{postId}}"
              ]
            },
            "description": "Authenticated (user B, the post author). Only the author can delete; a non-author or unknown post id gives 400. Empty response body.\n\nRun this last in the Posts folder — it removes the post the other requests reference."
          },
          "response": []
        }
      ]
    },
