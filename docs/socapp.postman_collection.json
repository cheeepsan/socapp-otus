{
  "info": {
    "_postman_id": "8f2b5c1e-4a63-4f0d-9f27-6f0c2a7d1b44",
    "name": "socapp",
    "description": "REST API collection for the socapp course project (OTUS Highload Architect).\n\nImport this file into Postman, start the app (see docs/run-guide.md), then run the folders in order. Requests save IDs and tokens into collection variables automatically, so most requests work out of the box after you have registered and logged in both users.\n\nUsers in this collection: user A = Ivan Petrov, user B = Maria Ivanova. The collection-level Bearer token is user A's session token ({{token}}); requests that act as user B override it with {{tokenB}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. Smoke",
      "item": [
        {
          "name": "Swagger UI is up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs/"
              ]
            },
            "description": "Confirms the server is running. The Swagger UI is served at /docs/ (a request to /docs without the trailing slash answers 308 with a redirect to ./docs/)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Register and login",
      "description": "Creates the two test users and logs both in. The tests save their IDs and tokens into collection variables (userA_id, userB_id, token, tokenB).",
      "item": [
        {
          "name": "Register user A (Ivan Petrov)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"userA_id\", body.user_id);",
                  "  pm.test(\"response contains user_id\", function () {",
                  "    pm.expect(body).to.have.property(\"user_id\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Ivan\",\n  \"second_name\": \"Petrov\",\n  \"birthdate\": \"1990-01-15\",\n  \"biography\": \"Hiking and Scala\",\n  \"city\": \"Moscow\",\n  \"password\": \"secret-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "register"
              ]
            },
            "description": "Registers a new user. `birthdate`, `biography` and `city` are optional. Returns {\"user_id\": \"...\"}. Blank first_name, second_name or password give 400."
          },
          "response": []
        },
        {
          "name": "Register user B (Maria Ivanova)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"userB_id\", body.user_id);",
                  "  pm.test(\"response contains user_id\", function () {",
                  "    pm.expect(body).to.have.property(\"user_id\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Maria\",\n  \"second_name\": \"Ivanova\",\n  \"birthdate\": \"1992-07-03\",\n  \"biography\": \"Photography\",\n  \"city\": \"Saint-Petersburg\",\n  \"password\": \"secret-2\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/user/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "user",
                "register"
              ]
            },
            "description": "Registers the second test user. Returns {\"user_id\": \"...\"}."
          },
          "response": []
        },
        {
          "name": "Login as user A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"token\", body.token);",
                  "  pm.test(\"response contains token\", function () {",
                  "    pm.expect(body).to.have.property(\"token\");",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{userA_id}}\",\n  \"password\": \"secret-1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Authenticates user A. The test script stores the returned token in {{token}}, which the collection uses as the default Bearer token."
          },
          "response": []
        },
        {
          "name": "Login as user B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set(\"tokenB\", body.token);",
                  "  pm.test(\"response contains token\", function () {",
                  "    pm.expect(body).to.have.property(\"token\");",
